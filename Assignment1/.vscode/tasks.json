{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build MSP432",
      "type": "shell",
      "command": "C:/ti/ccs2100/ccs/utils/bin/gmake.exe",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "Clean MSP432",
      "type": "shell",
      "command": "C:/ti/ccs2100/ccs/utils/bin/gmake.exe",
      "args": [
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}